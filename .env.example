# URL of the OWASP Juice Shop instance under test.
# Copy this file to .env and fill in the value. Never commit .env.
# When running the suite with Docker Compose (npm run test:docker), use the
# Compose service name and container port of Juice Shop as the host.
BASE_URL=

# Optional: host port for browsing the Dockerised Juice Shop (defaults to 3000).
# JUICE_SHOP_PORT=
